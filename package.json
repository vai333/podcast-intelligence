    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
