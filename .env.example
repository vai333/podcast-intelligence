# Copy to .env.local for local development. On Vercel set the same names under Project > Settings > Environment Variables.
# Never commit real values.

DATABASE_URL=                 # Neon pooled connection string (the one containing "-pooler")
CRON_SECRET=                  # long random string, also set in Vercel (Vercel Cron sends it as a Bearer token)
SESSION_SECRET=               # long random string (32+ chars) used to sign the login cookie
ADMIN_USERNAME=admin          # sign-in username
ADMIN_PASSWORD=               # sign-in password (choose a strong one for production)
BRIEF_RECIPIENTS=             # comma-separated emails that receive the Monday brief
APP_URL=                      # e.g. https://your-app.vercel.app (no trailing slash; http://localhost:3100 locally)

YOUTUBE_API_KEY=              # Google Cloud Console > enable "YouTube Data API v3" > create an API key
GEMINI_API_KEY=               # Google AI Studio > Get API key
GEMINI_MODEL=gemini-3.8-flash # primary model (gemini-2.5-flash from the original spec is retired for new keys)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash  # tried in order if the primary is rate limited or overloaded
GEMINI_DAILY_EPISODE_LIMIT=40 # max episodes analysed per IST day
GEMINI_MAX_VIDEO_TOKENS=230000 # longer videos are analysed from title and description (free tier allows 250K tokens/minute)

RESEND_API_KEY=               # optional until set: resend.com > API keys
EMAIL_FROM=                   # a sender verified in Resend, e.g. "Podcast Intelligence <brief@yourdomain.com>"
SEED_BACKFILL_DAYS=7          # one-time backfill for `npm run seed` only

# DATA_SOURCE=mock            # run the dashboard on built-in sample data with no database (development only)
